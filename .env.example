# ============================================
# AI CONFIGURATION
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_EMBEDDING_MODEL=text-embedding-004
GEMINI_MODEL=gemini-1.5-pro

# Mock mode - set to true to bypass API calls during development
MOCK_MODE=false

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://brd_user:brd_password@localhost:5432/brd_generator

# ============================================
# VECTOR DATABASE (ChromaDB)
# ============================================
CHROMA_HOST=http://localhost:8000

# Alternative: Pinecone (comment out ChromaDB if using this)
# PINECONE_API_KEY=your_pinecone_key
# PINECONE_INDEX=brd-embeddings

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# AUTHENTICATION (Clerk)
# ============================================
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# ============================================
# INTEGRATIONS (Optional)
# ============================================
# Gmail API
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/api/integrations/gmail/callback

# Slack API
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3001/api/integrations/slack/callback

# Fireflies.ai
FIREFLIES_API_KEY=

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# File upload limits (in MB)
MAX_FILE_SIZE=50

# Chunking configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Noise filtering threshold (0-1)
RELEVANCE_THRESHOLD=0.6

# Deduplication similarity threshold (0-1)
SIMILARITY_THRESHOLD=0.92
