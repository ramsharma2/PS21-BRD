{
    "name": "brd-backend",
    "version": "1.0.0",
    "description": "Backend API for BRD Generator",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:push": "prisma db push",
        "db:seed": "tsx src/utils/seed.ts",
        "db:studio": "prisma studio",
        "lint": "eslint src --ext .ts",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "dependencies": {
        "@clerk/clerk-sdk-node": "^5.0.0",
        "@google/generative-ai": "^0.21.0",
        "@langchain/community": "^0.3.0",
        "@langchain/core": "^0.3.0",
        "@langchain/google-genai": "^0.1.0",
        "@prisma/client": "^5.22.0",
        "bullmq": "^5.13.0",
        "chromadb": "^1.9.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.1",
        "express-rate-limit": "^7.4.1",
        "googleapis": "^144.0.0",
        "helmet": "^8.0.0",
        "ioredis": "^5.4.1",
        "mammoth": "^1.8.0",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^8.0.1",
        "pdf-parse": "^1.1.1",
        "xlsx": "^0.18.5",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.9.0",
        "@types/pdf-parse": "^1.1.4",
        "@typescript-eslint/eslint-plugin": "^8.14.0",
        "@typescript-eslint/parser": "^8.14.0",
        "eslint": "^9.14.0",
        "prettier": "^3.3.3",
        "prisma": "^5.22.0",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3"
    }
}